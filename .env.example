# ==============================================================================
# 🏥 SANJEEVANI AI — Google AI & Cloud Services Environment Configuration
# Code for Communities 2 (Track 3: Smart Health & Supply Chain Resilience)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini & Generative AI (Google AI Studio / Vertex AI)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform & Vertex AI Project Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=sanjeevani-ai-health-national
GOOGLE_CLOUD_REGION=asia-south1
# Optional: Path to Service Account JSON key if using GCP IAM authentication
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------------------------
# 3. Google BigQuery Health Data Warehouse
# ------------------------------------------------------------------------------
BIGQUERY_DATASET=indian_public_health_surveillance
BIGQUERY_TABLE_MORBIDITY=district_morbidity_cube

# ------------------------------------------------------------------------------
# 4. Firebase (Real-time Cold-Chain IoT DB & ASHA Auth)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=sanjeevani-health-iot
FIREBASE_DATABASE_URL=https://sanjeevani-health-iot-default-rtdb.firebaseio.com
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=sanjeevani-health-iot.firebaseapp.com

# ------------------------------------------------------------------------------
# 5. Google Maps Platform (Routing & Distance Matrix)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 6. Service Hosts & Ports (Cloud Run / Local)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
